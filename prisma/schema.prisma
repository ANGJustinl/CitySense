enum AppRole {
  USER
  MODERATOR
  ADMIN
}

enum VenuePublicationStatus {
  PUBLISHED
  UNLISTED
  REMOVED
}

enum VenueSubmissionStatus {
  DRAFT
  SUBMITTED
  PROCESSING
  AUTO_PUBLISHED
  NEEDS_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  WITHDRAWN
  REMOVED
}

enum SubmissionMatchType {
  EXISTING_EXACT
  EXISTING_PROBABLE
  AMAP_EXACT
  AMAP_PROBABLE
  NOVEL
  AMBIGUOUS
}

enum SubmissionImageStatus {
  RESERVED
  UPLOADED
  VALIDATING
  SAFE
  FAILED
  DELETED
}

enum ModerationActorType {
  SYSTEM
  MODERATOR
  ADMIN
  USER
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AppUser {
  id                String                       @id @db.Uuid
  role              AppRole                      @default(USER)
  emailSnapshot     String?
  disabledAt        DateTime?
  lastSignedInAt    DateTime?
  submissions       VenueSubmission[]
  moderationActions SubmissionModerationAction[]
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
}

model VenueSubmission {
  id                   String                       @id @default(cuid())
  submitterId          String                       @db.Uuid
  submitter            AppUser                      @relation(fields: [submitterId], references: [id], onDelete: Cascade)
  status               VenueSubmissionStatus        @default(DRAFT)
  version              Int                          @default(1)
  idempotencyKey       String?
  name                 String
  description          String?
  city                 String
  area                 String?
  address              String
  userLat              Float?
  userLng              Float?
  verifiedAddress      String?
  verifiedLat          Float?
  verifiedLng          Float?
  tags                 String[]
  accessTips           String?
  selectedAmapPoiId    String?
  selectedAmapSnapshot Json?
  matchType            SubmissionMatchType?
  matchedVenueId       String?
  matchedVenue         Venue?                       @relation("SubmissionMatchedVenue", fields: [matchedVenueId], references: [id], onDelete: SetNull)
  resultingVenueId     String?
  resultingVenue       Venue?                       @relation("SubmissionResultingVenue", fields: [resultingVenueId], references: [id], onDelete: SetNull)
  contentHash          String?
  technicalFlags       String[]                     @default([])
  automatedResult      Json?
  publicStatusMessage  String?
  submittedAt          DateTime?
  processingStartedAt  DateTime?
  processingLeaseUntil DateTime?
  reviewedAt           DateTime?
  publishedAt          DateTime?
  withdrawnAt          DateTime?
  images               SubmissionImage[]
  moderationActions    SubmissionModerationAction[]
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt

  @@unique([submitterId, idempotencyKey])
  @@index([submitterId, createdAt])
  @@index([status, submittedAt])
  @@index([city, status])
  @@index([contentHash])
  @@index([matchedVenueId])
  @@index([resultingVenueId])
}

model SubmissionImage {
  id                  String                @id @default(cuid())
  submissionId        String
  submission          VenueSubmission       @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  originalObjectPath  String                @unique
  processedObjectPath String?
  status              SubmissionImageStatus @default(RESERVED)
  declaredMimeType    String?
  detectedMimeType    String?
  byteSize            Int?
  width               Int?
  height              Int?
  sha256              String?
  validationError     String?
  createdAt           DateTime              @default(now())
  validatedAt         DateTime?

  @@index([submissionId, status])
  @@index([sha256])
}

model VenueImage {
  id           String   @id @default(cuid())
  venueId      String
  venue        Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  submissionId String?
  objectPath   String   @unique
  publicUrl    String
  width        Int
  height       Int
  isPrimary    Boolean  @default(false)
  published    Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([venueId, published])
  @@index([submissionId])
}

model SubmissionModerationAction {
  id           String                 @id @default(cuid())
  submissionId String
  submission   VenueSubmission        @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  actorUserId  String?                @db.Uuid
  actorUser    AppUser?               @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorType    ModerationActorType
  action       String
  fromStatus   VenueSubmissionStatus?
  toStatus     VenueSubmissionStatus
  reasonCode   String?
  reasonText   String?
  metadata     Json?
  createdAt    DateTime               @default(now())

  @@index([submissionId, createdAt])
  @@index([actorUserId, createdAt])
}

model SourceConnector {
  id              String    @id @default(cuid())
  name            String    @unique
  type            String
  status          String
  enabled         Boolean   @default(true)
  cooldownSeconds Int       @default(60)
  config          Json?
  lastRunId       String?
  lastRunAt       DateTime?
  lastSuccessAt   DateTime?
  lastErrorAt     DateTime?
  lastError       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model RawSourceItem {
  id                   String    @id @default(cuid())
  source               String
  sourceKey            String    @unique
  sourceId             String?
  sourceUrl            String?
  title                String
  content              String?
  author               String?
  rawPayload           Json?
  parsedPayload        Json?
  city                 String?
  area                 String?
  publishedAt          DateTime?
  status               String
  itemType             String
  normalizedEntityType String?
  normalizedEntityId   String?
  ingestRunId          String?
  firstSeenAt          DateTime  @default(now())
  lastSeenAt           DateTime  @default(now())
  createdAt            DateTime  @default(now())

  @@index([source])
  @@index([city])
  @@index([ingestRunId])
}

model Event {
  id           String    @id @default(cuid())
  sourceKey    String?   @unique
  title        String
  description  String?
  city         String
  area         String?
  address      String?
  lat          Float?
  lng          Float?
  startTime    DateTime?
  endTime      DateTime?
  tags         String[]
  source       String?
  sourceUrl    String?
  imageUrl     String?
  imageSource  String?
  venueId      String?
  venue        Venue?    @relation("EventVenue", fields: [venueId], references: [id], onDelete: SetNull)
  trendScore   Float     @default(0)
  confidence   Float     @default(0)
  qualityScore Float     @default(50)
  qualityFlags String[]  @default([])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([city])
  @@index([area])
  @@index([startTime])
  @@index([qualityScore])
  @@index([venueId])
}

model Venue {
  id                      String                 @id @default(cuid())
  sourceKey               String?                @unique
  name                    String
  description             String?
  city                    String
  area                    String?
  address                 String?
  lat                     Float?
  lng                     Float?
  tags                    String[]
  priceLevel              Int?
  quietness               Int?
  popularity              Int?
  source                  String?
  sourceUrl               String?
  imageUrl                String?
  imageSource             String?
  trendScore              Float                  @default(0)
  confidence              Float                  @default(0)
  qualityScore            Float                  @default(50)
  qualityFlags            String[]               @default([])
  publicationStatus       VenuePublicationStatus @default(PUBLISHED)
  publishedAt             DateTime?
  unpublishedAt           DateTime?
  publicationReason       String?
  publicationVersion      Int                    @default(1)
  createdFromSubmissionId String?                @unique
  events                  Event[]                @relation("EventVenue")
  matchedSubmissions      VenueSubmission[]      @relation("SubmissionMatchedVenue")
  resultingSubmissions    VenueSubmission[]      @relation("SubmissionResultingVenue")
  images                  VenueImage[]
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  @@index([city])
  @@index([area])
  @@index([qualityScore])
  @@index([publicationStatus, city, area])
}

model CitySignal {
  id         String   @id @default(cuid())
  city       String
  area       String?
  tag        String
  heatScore  Float
  source     String
  capturedAt DateTime
  metadata   Json?

  @@index([city])
  @@index([area])
  @@index([tag])
  @@index([capturedAt])
}

model CitySignalPlaceMatch {
  id              String    @id @default(cuid())
  source          String
  rawSourceItemId String?
  citySignalId    String?
  venueId         String?
  status          String
  algorithmScore  Float     @default(0)
  llmConfidence   Float?
  matchedFields   String[]  @default([])
  reason          String?
  metadata        Json?
  reviewedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([source])
  @@index([status])
  @@index([rawSourceItemId])
  @@index([citySignalId])
  @@index([venueId])
  @@index([source, status])
  @@index([venueId, status])
}

model IngestRun {
  id          String    @id @default(cuid())
  city        String
  area        String?
  keywords    String[]
  sources     String[]
  status      String
  requestedBy String?
  force       Boolean   @default(false)
  stats       Json?
  error       String?
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
}

model TrafficSnapshot {
  id         String   @id @default(cuid())
  city       String
  originLat  Float
  originLng  Float
  destLat    Float
  destLng    Float
  mode       String
  distance   Int?
  duration   Int?
  congestion String?
  rawPayload Json?
  capturedAt DateTime @default(now())

  @@index([city])
  @@index([capturedAt])
}

model CityConditionSnapshot {
  id         String   @id @default(cuid())
  city       String
  area       String?
  venueId    String?
  condition  String
  score      Float
  label      String?
  source     String
  confidence Float
  metadata   Json?
  capturedAt DateTime @default(now())
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([city])
  @@index([area])
  @@index([venueId])
  @@index([condition])
  @@index([capturedAt])
  @@index([expiresAt])
  @@index([city, area, condition, expiresAt])
}

model UserPreference {
  id             String    @id @default(cuid())
  userId         String    @unique
  interests      String[]
  mood           String?
  budget         String?
  metadata       Json?
  // 画像快照元数据，便于 SQL 排查画像版本、稀疏度和最近一次重置边界。
  // 完整画像快照写在 metadata.profile；profileResetAt 之前的行为只保留审计，不再参与重算。
  profileVersion Int?
  signalCount    Int?
  profileResetAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model RecommendationLog {
  id                String   @id @default(cuid())
  userId            String?
  input             Json
  recommendedRoutes Json
  feedback          Json?
  createdAt         DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model UserInteraction {
  id               String   @id @default(cuid())
  userId           String?
  recommendationId String?
  routeId          String?
  itemId           String?
  itemType         String?
  action           String
  weight           Float    @default(1)
  feedbackId       String?
  signalKey        String?  @unique
  signalKind       String?
  context          Json?
  createdAt        DateTime @default(now())

  @@index([userId])
  @@index([userId, createdAt])
  @@index([recommendationId])
  @@index([itemId])
  @@index([action])
  @@index([feedbackId])
  @@index([createdAt])
}

model RecommendationFeatureSnapshot {
  id               String   @id @default(cuid())
  recommendationId String
  candidateId      String
  candidateType    String
  ranker           String
  rankerVersion    String
  recallChannels   String[]
  features         Json
  score            Float
  position         Int
  createdAt        DateTime @default(now())

  @@index([recommendationId])
  @@index([candidateId])
  @@index([ranker])
}

model RecommendationFeedback {
  id                  String   @id @default(cuid())
  recommendationLogId String   @map("recommendation_log_id")
  routeId             String   @map("route_id")
  userId              String?  @map("user_id")
  sessionId           String?  @map("session_id")
  value               String
  reason              String?
  createdAt           DateTime @default(now()) @map("created_at")

  @@index([recommendationLogId])
  @@index([routeId])
  @@index([userId])
  @@index([sessionId])
  @@index([value])
  @@index([createdAt])
  @@map("recommendation_feedbacks")
}
