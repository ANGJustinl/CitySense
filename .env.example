# PostgreSQL connection used by the application and production migrations.
# For Docker Compose production, use the private service hostname `db`.
# Example: postgresql://citysense:password@db:5432/citysense?schema=public
DATABASE_URL=""
POSTGRES_DB="citysense"
POSTGRES_USER="citysense"
POSTGRES_PASSWORD=""
DATABASE_CONNECTION_LIMIT="5"
DATABASE_POOL_TIMEOUT="20"
CITYSENSE_RELEASE="development"
CITYSENSE_DEMO_MODE="false"
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
CITYSENSE_ADMIN_EMAILS=""
CITYSENSE_UGC_ENABLED="false"
CITYSENSE_UGC_AUTO_PUBLISH_ENABLED="false"
CITYSENSE_UGC_NOVEL_AUTO_PUBLISH_ENABLED="false"
CITYSENSE_SUBMISSION_ORIGINAL_BUCKET="submission-originals"
NEXT_PUBLIC_CITYSENSE_SUBMISSION_ORIGINAL_BUCKET="submission-originals"
CITYSENSE_VENUE_IMAGE_BUCKET="venue-images"
CITYSENSE_SUBMISSION_MAX_IMAGES="5"
CITYSENSE_SUBMISSION_MAX_IMAGE_BYTES="10485760"
CITYSENSE_SUBMISSION_RATE_LIMIT_PER_DAY="5"
CITYSENSE_SUBMISSION_POLICY_VERSION="v1"
REDIS_URL=""
AMAP_API_KEY=""
# NEXT_PUBLIC_* values are embedded into the browser bundle at image build time.
# They are public configuration, not server-side secrets.
NEXT_PUBLIC_AMAP_JS_API_KEY=""
NEXT_PUBLIC_AMAP_SECURITY_JS_CODE=""
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.5"
OPENAI_TIMEOUT_MS="8000"
CITYSENSE_MOMENT_CARD_TIMEOUT_MS="6000"
CITYSENSE_MOMENT_CARD_MODEL=""
# Preferred. OPENAI_API_BASE or API_BASE are also accepted as aliases.
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_API_BASE=""
API_BASE=""
CITYSENSE_LLM_NORMALIZE_ENABLED="true"
CITYSENSE_LLM_NORMALIZE_SOURCES="all"
CITYSENSE_LLM_NORMALIZE_TIMEOUT_MS="15000"
NORMALIZE_WORKER_ITEM_CONCURRENCY="1"
BILIBILI_MCP_URL=""
BILIBILI_MCP_TOKEN=""
XIAOHONGSHU_MCP_URL="http://localhost:18060/mcp"
XIAOHONGSHU_MCP_TOKEN=""
XIAOHONGSHU_MCP_SEARCH_TOOL="ai_search_chat"
XIAOHONGSHU_MCP_AI_SEARCH_INCLUDE_SOURCES="true"
XIAOHONGSHU_MCP_AI_SEARCH_SOURCE_LIMIT="20"
XIAOHONGSHU_MCP_AI_SEARCH_TIMEOUT_SECONDS="90"
TRENDS_HUB_MCP_COMMAND="npx"
TRENDS_HUB_MCP_ARGS="-y mcp-trends-hub"
TRENDS_HUB_MCP_TOOLS="get_weibo_trending,get_zhihu_trending,get_toutiao_trending,get_thepaper_trending"
TRENDS_HUB_HIDDEN_FIELDS="cover"
TRENDS_HUB_MAX_ITEMS="30"
SHANGHAI_GOV_EVENTS_URL="https://www.shanghai.gov.cn/nw31406/index.html"
SHANGHAI_GOV_MAX_DETAILS="8"

# MCP HTTP server (remote access for external agents).
# Generate a strong token, e.g. `openssl rand -hex 32`. REQUIRED for `pnpm mcp:http`;
# the server refuses to start without it so it can never be exposed publicly unauthenticated.
MCP_API_TOKEN=""
# Bind host. 0.0.0.0 listens on all interfaces (needed for Docker / public exposure).
MCP_HOST="0.0.0.0"
# Bind port.
MCP_PORT="18070"

# TASK-P2-004 AI 对话助手(可选;复用 OPENAI_API_KEY)
CHAT_LLM_BASE_URL="https://open.bigmodel.cn/api/paas/v4"
CHAT_LLM_MODEL="glm-4-flash"
